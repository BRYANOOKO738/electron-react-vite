{
  "name": "electron-react-vite",
  "productName": "Electron React Vite",
  "version": "1.0.0",
  "description": "A secure, ready-to-ship desktop app template with Electron, React, Vite and Tailwind CSS.",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "setup": "node scripts/setup.js",
    "postinstall": "node scripts/postinstall.js",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "test": "electron-forge package && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BRYANOOKO738/electron-react-vite.git"
  },
  "homepage": "https://github.com/BRYANOOKO738/electron-react-vite#readme",
  "bugs": {
    "url": "https://github.com/BRYANOOKO738/electron-react-vite/issues"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "tailwindcss",
    "electron-forge",
    "template",
    "desktop"
  ],
  "author": {
    "name": "Bryan Onyango",
    "email": "ookobryan8@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "electron": "39.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  }
}
